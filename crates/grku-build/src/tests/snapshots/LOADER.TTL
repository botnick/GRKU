filedelete 'C:\SCRIPT\GRKU\PLAN.BIN'
filedelete 'C:\SCRIPT\GRKU\PLAN.TMP'
filedelete 'C:\SCRIPT\GRKU\INSTALL.OK'
filedelete 'C:\SCRIPT\GRKU\INSTALL.LCK'
intdim ba 256
intdim mb 16
mb[0] = 0
mb[10] = 0
mb[11] = 0
mb[12] = 0
mb[13] = 0
fast = 0
attempts = 0
failure = 60
call write_error
filesearch 'C:\SCRIPT\GRKU\PLAN.BIN'
if result != 0 goto reject
filesearch 'C:\SCRIPT\GRKU\INSTALL.OK'
if result != 0 goto reject
mpause 2000
sendln 'lcmd_resp on'
started = 0
:scan
if started <> 0 goto scan_posted
sendln 'lcmd sh /media/storage1/SCRIPT/GRKU/SCAN.SH'
started = mb[12]
:scan_posted
posted = mb[0]
if posted = 827150919 goto plan_box
filesearch 'C:\SCRIPT\GRKU\PLAN.BIN'
if result != 0 goto plan_file
posted = mb[10]
if posted = 2 goto start_failed
mpause 150
attempts = attempts + 1
if attempts < 1000 goto scan
goto reject
:plan_box
failure = 61
count = mb[1]
words = mb[2]
chunks = mb[3]
modulewords = mb[5]
moduletiles = mb[6]
goto plan_check
:plan_file
failure = 61
fileopen fh 'C:\SCRIPT\GRKU\PLAN.BIN' 0
if fh < 0 goto reject
call readword
if value != 827150919 goto reject_close
call readword
count = value
call readword
words = value
call readword
chunks = value
call readword
call readword
modulewords = value
call readword
moduletiles = value
fileclose fh
:plan_check
if count < 0 goto reject
if count > 40 goto reject
if modulewords < 0 goto reject
if modulewords > 65536 goto reject
if moduletiles < 0 goto reject
if moduletiles > 128 goto reject
expected = 1538 + count * 1088
if words != expected goto reject
expectedchunks = (count + moduletiles + 47) / 40
if chunks != expectedchunks goto reject
intdim registry words
if chunks <= 0 goto icons_ready
items = count + moduletiles + 8 - 0
if items > 40 items = 40
iconwords = items * 1602
intdim artwork0 iconwords
if chunks <= 1 goto icons_ready
items = count + moduletiles + 8 - 40
if items > 40 items = 40
iconwords = items * 1602
intdim artwork1 iconwords
if chunks <= 2 goto icons_ready
items = count + moduletiles + 8 - 80
if items > 40 items = 40
iconwords = items * 1602
intdim artwork2 iconwords
if chunks <= 3 goto icons_ready
items = count + moduletiles + 8 - 120
if items > 40 items = 40
iconwords = items * 1602
intdim artwork3 iconwords
if chunks <= 4 goto icons_ready
items = count + moduletiles + 8 - 160
if items > 40 items = 40
iconwords = items * 1602
intdim artwork4 iconwords
:icons_ready
if modulewords <= 0 goto modules_ready
intdim modulecode modulewords
:modules_ready
intdim tailarea 49951
failure = 62
call write_error
mb[13] = 1
attempts = 0
waits = 300
:install
posted = mb[10]
if posted = 1 goto installed
if posted = 2 goto start_failed
filesearch 'C:\SCRIPT\GRKU\INSTALL.OK'
if result != 0 goto installed
call read_error
if errorstatus = 62 goto install_wait
if errorstatus != 0 goto reject
:install_wait
mpause 100
attempts = attempts + 1
if fast <> 0 goto install_next
watchdog = attempts % 100
if watchdog = 0 sendln 'lcmd sh /media/storage1/SCRIPT/GRKU/INSTALL.SH'
:install_next
if attempts > waits mpause 9500
goto install
:installed
filedelete 'C:\SCRIPT\GRKU\INSTALL.ERR'
filesearch 'C:\SCRIPT\GRKU\RESIDENT.TTL'
if result = 0 end
include 'C:\SCRIPT\GRKU\RESIDENT.TTL'
end
:start_failed
failure = mb[11]
if failure <= 0 goto reject
if failure > 99 goto reject
call write_error
goto reject
:reject_close
fileclose fh
:reject
call read_error
if errorstatus = 0 goto reject_write
if errorstatus = 60 goto reject_write
if errorstatus = 62 goto reject_write
goto reject_end
:reject_write
call write_error
:reject_end
dispstr 'GR_MODULE_LOADER_REJECTED'
end
:readword
value = 0
weight = 1
for byteindex 0 3
fileread fh 1 octet
if result != 0 goto reject_close
str2code bytevalue octet
value = value + bytevalue * weight
if byteindex < 3 weight = weight * 256
next
return
:write_error
filedelete 'C:\SCRIPT\GRKU\INSTALL.ERR'
filecreate efh 'C:\SCRIPT\GRKU\INSTALL.ERR'
if efh < 0 goto write_error_end
int2str line failure
filewriteln efh line
int2str line attempts
filewriteln efh line
filewrite efh 'mailbox'
filewrite efh ' started '
mailword = mb[12]
int2str line mailword
filewrite efh line
filewrite efh ' plan '
mailword = mb[0]
int2str line mailword
filewrite efh line
filewrite efh ' result '
mailword = mb[10]
int2str line mailword
filewrite efh line
filewrite efh ' status '
mailword = mb[11]
int2str line mailword
filewrite efh line
filewrite efh ' arrays '
mailword = mb[13]
int2str line mailword
filewrite efh line
filewriteln efh ''
fileclose efh
:write_error_end
return
:read_error
errorstatus = 0
fileopen efh 'C:\SCRIPT\GRKU\INSTALL.ERR' 0
if efh < 0 goto read_error_end
fileread efh 1 octet
if result != 0 goto read_error_close
str2code bytevalue octet
errorstatus = (bytevalue - 48) * 10
fileread efh 1 octet
if result != 0 goto read_error_close
str2code bytevalue octet
errorstatus = errorstatus + bytevalue - 48
:read_error_close
fileclose efh
:read_error_end
return
