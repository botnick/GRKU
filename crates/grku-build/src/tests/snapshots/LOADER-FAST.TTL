filedelete 'C:\SCRIPT\GRKU\PLAN.BIN'
filedelete 'C:\SCRIPT\GRKU\PLAN.TMP'
filedelete 'C:\SCRIPT\GRKU\INSTALL.OK'
filedelete 'C:\SCRIPT\GRKU\INSTALL.LCK'
intdim ba 256
intdim mb 16
mb[0] = 0
mb[10] = 0
mb[11] = 0
mb[12] = 0
mb[13] = 0
fast = 0
allocated = 0
fastreason = 1
ba[0] = 0
ba[1] = 0
sendln 'SYS_buildinfo 0'
if ba[0] <> 1129202771 goto probed
fastreason = 2
fastinterface = ba[1]
if ba[1] <> 1 goto probed
fastreason = 3
release = ba[2] * 1000 + ba[3]
if release <> 588210 goto probe1
fastreason = 4
filesearch 'C:\SCRIPT\GRKU\F588210.BIN'
if result = 0 goto probe1
filesearch 'C:\SCRIPT\GRKU\I588210.BIN'
if result <> 0 fast = 588210
:probe1
if release <> 588220 goto probe2
fastreason = 4
filesearch 'C:\SCRIPT\GRKU\F588220.BIN'
if result = 0 goto probe2
filesearch 'C:\SCRIPT\GRKU\I588220.BIN'
if result <> 0 fast = 588220
:probe2
:probed
if fast = 0 call fast_log
attempts = 0
failure = 60
call write_error
filesearch 'C:\SCRIPT\GRKU\PLAN.BIN'
if result != 0 goto reject
filesearch 'C:\SCRIPT\GRKU\INSTALL.OK'
if result != 0 goto reject
if fast = 0 goto linux
ba[254] = 999
if fast = 588210 sendln 'SYS_memovr C:\SCRIPT\GRKU\F588210.BIN 0 call'
if fast = 588220 sendln 'SYS_memovr C:\SCRIPT\GRKU\F588220.BIN 0 call'
faststatus = ba[254]
filesearch 'C:\SCRIPT\GRKU\PLAN.BIN'
if result != 0 goto plan_file
fastreason = 5
call fast_log
fast = 0
:linux
mpause 2000
sendln 'lcmd_resp on'
started = 0
:scan
if started <> 0 goto scan_posted
sendln 'lcmd sh /media/storage1/SCRIPT/GRKU/SCAN.SH'
started = mb[12]
:scan_posted
posted = mb[0]
if posted = 827150919 goto plan_box
filesearch 'C:\SCRIPT\GRKU\PLAN.BIN'
if result != 0 goto plan_file
posted = mb[10]
if posted = 2 goto start_failed
mpause 150
attempts = attempts + 1
if attempts < 1000 goto scan
goto reject
:plan_box
failure = 61
count = mb[1]
words = mb[2]
chunks = mb[3]
modulewords = mb[5]
moduletiles = mb[6]
goto plan_check
:plan_file
failure = 61
fileopen fh 'C:\SCRIPT\GRKU\PLAN.BIN' 0
if fh < 0 goto reject
call readword
if value != 827150919 goto reject_close
call readword
count = value
call readword
words = value
call readword
chunks = value
call readword
call readword
modulewords = value
call readword
moduletiles = value
fileclose fh
:plan_check
if count < 0 goto reject
if count > 40 goto reject
if modulewords < 0 goto reject
if modulewords > 65536 goto reject
if moduletiles < 0 goto reject
if moduletiles > 128 goto reject
expected = 1538 + count * 1088
if words != expected goto reject
expectedchunks = (count + moduletiles + 47) / 40
if chunks != expectedchunks goto reject
if allocated <> 0 goto check_arrays
intdim registry words
if chunks <= 0 goto icons_ready
items = count + moduletiles + 8 - 0
if items > 40 items = 40
iconwords = items * 1602
intdim artwork0 iconwords
if chunks <= 1 goto icons_ready
items = count + moduletiles + 8 - 40
if items > 40 items = 40
iconwords = items * 1602
intdim artwork1 iconwords
if chunks <= 2 goto icons_ready
items = count + moduletiles + 8 - 80
if items > 40 items = 40
iconwords = items * 1602
intdim artwork2 iconwords
if chunks <= 3 goto icons_ready
items = count + moduletiles + 8 - 120
if items > 40 items = 40
iconwords = items * 1602
intdim artwork3 iconwords
if chunks <= 4 goto icons_ready
items = count + moduletiles + 8 - 160
if items > 40 items = 40
iconwords = items * 1602
intdim artwork4 iconwords
:icons_ready
if modulewords <= 0 goto modules_ready
intdim modulecode modulewords
:modules_ready
intdim tailarea 49951
allocated = 1
hadcount = count
hadwords = words
hadchunks = chunks
hadmodwords = modulewords
hadmodtiles = moduletiles
goto arrays_ready
:check_arrays
if count <> hadcount goto reject
if words <> hadwords goto reject
if chunks <> hadchunks goto reject
if modulewords <> hadmodwords goto reject
if moduletiles <> hadmodtiles goto reject
:arrays_ready
failure = 62
call write_error
mb[13] = 1
attempts = 0
waits = 300
:install
ba[254] = 999
if fast = 588210 sendln 'SYS_memovr C:\SCRIPT\GRKU\I588210.BIN 0 call'
if fast = 588220 sendln 'SYS_memovr C:\SCRIPT\GRKU\I588220.BIN 0 call'
faststatus = ba[254]
if fast = 0 faststatus = 0
if faststatus >= 998 goto install_not_run
posted = mb[10]
if posted = 1 goto installed
if posted = 2 goto start_failed
filesearch 'C:\SCRIPT\GRKU\INSTALL.OK'
if result != 0 goto installed
call read_error
if errorstatus = 62 goto install_wait
if errorstatus != 0 goto install_failed
:install_wait
mpause 100
attempts = attempts + 1
if fast <> 0 goto install_next
watchdog = attempts % 100
if watchdog = 0 sendln 'lcmd sh /media/storage1/SCRIPT/GRKU/INSTALL.SH'
:install_next
if attempts > waits mpause 9500
goto install
:installed
filedelete 'C:\SCRIPT\GRKU\INSTALL.ERR'
filesearch 'C:\SCRIPT\GRKU\RESIDENT.TTL'
if result = 0 end
include 'C:\SCRIPT\GRKU\RESIDENT.TTL'
end
:start_failed
failure = mb[11]
if failure <= 0 goto reject
if failure > 99 goto reject
call write_error
goto reject
:install_not_run
errorstatus = faststatus
:install_failed
if fast = 0 goto reject
if errorstatus = 24 goto reject
faststatus = errorstatus
fastreason = 6
call fast_log
fast = 0
filedelete 'C:\SCRIPT\GRKU\PLAN.BIN'
filedelete 'C:\SCRIPT\GRKU\PLAN.TMP'
filedelete 'C:\SCRIPT\GRKU\INSTALL.LCK'
attempts = 0
failure = 60
call write_error
goto linux
:reject_close
fileclose fh
:reject
call read_error
if errorstatus = 0 goto reject_write
if errorstatus = 60 goto reject_write
if errorstatus = 62 goto reject_write
goto reject_end
:reject_write
call write_error
:reject_end
dispstr 'GR_MODULE_LOADER_REJECTED'
end
:readword
value = 0
weight = 1
for byteindex 0 3
fileread fh 1 octet
if result != 0 goto reject_close
str2code bytevalue octet
value = value + bytevalue * weight
if byteindex < 3 weight = weight * 256
next
return
:write_error
filedelete 'C:\SCRIPT\GRKU\INSTALL.ERR'
filecreate efh 'C:\SCRIPT\GRKU\INSTALL.ERR'
if efh < 0 goto write_error_end
int2str line failure
filewriteln efh line
int2str line attempts
filewriteln efh line
filewrite efh 'mailbox'
filewrite efh ' started '
mailword = mb[12]
int2str line mailword
filewrite efh line
filewrite efh ' plan '
mailword = mb[0]
int2str line mailword
filewrite efh line
filewrite efh ' result '
mailword = mb[10]
int2str line mailword
filewrite efh line
filewrite efh ' status '
mailword = mb[11]
int2str line mailword
filewrite efh line
filewrite efh ' arrays '
mailword = mb[13]
int2str line mailword
filewrite efh line
filewriteln efh ''
fileclose efh
:write_error_end
return
:read_error
errorstatus = 0
fileopen efh 'C:\SCRIPT\GRKU\INSTALL.ERR' 0
if efh < 0 goto read_error_end
fileread efh 1 octet
if result != 0 goto read_error_close
str2code bytevalue octet
errorstatus = (bytevalue - 48) * 10
fileread efh 1 octet
if result != 0 goto read_error_close
str2code bytevalue octet
errorstatus = errorstatus + bytevalue - 48
:read_error_close
fileclose efh
:read_error_end
return
:fast_log
foldersearch 'C:\GRKU'
if result = 0 foldercreate 'C:\GRKU'
filesearch 'C:\GRKU\BOOT.TXT'
if result != 0 goto fast_log_append
filecreate lfh 'C:\GRKU\BOOT.TXT'
goto fast_log_opened
:fast_log_append
fileopen lfh 'C:\GRKU\BOOT.TXT' 1
:fast_log_opened
if lfh < 0 goto fast_log_end
filewrite lfh 'fast-boot'
if fastreason = 1 filewrite lfh ' off: official firmware'
if fastreason = 2 filewrite lfh ' off: interface '
if fastreason = 2 int2str line fastinterface
if fastreason = 2 filewrite lfh line
if fastreason >= 3 filewrite lfh ' '
if fastreason >= 3 int2str line release
if fastreason >= 3 filewrite lfh line
if fastreason = 3 filewrite lfh ' off: not in this package'
if fastreason = 4 filewrite lfh ' off: files missing'
if fastreason = 5 filewrite lfh ' scan '
if fastreason = 6 filewrite lfh ' install '
if fastreason >= 5 int2str line faststatus
if fastreason >= 5 filewrite lfh line
if fastreason >= 5 filewrite lfh ', Linux used'
filewriteln lfh ''
fileclose lfh
:fast_log_end
return
